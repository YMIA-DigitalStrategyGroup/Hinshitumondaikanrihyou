    {
      "$type": "ServerDesignerCommon.Command.ExecuteSqlCommand, ServerDesignerCommon",
      "ConnStrId": "Sql品質保証部",
      "Params": {},
      "SqlStatement": "INSERT INTO 品質問題_Fコスト集計版(W番号, 対象年月, 支払額, 倉出, 運賃, 総クレーム費, メーカー責任額, 求債額, YMIAクレーム費, 承認番号 , 申請フラグ)\r\nSELECT \r\n    W番号, \r\n    対象年月, \r\n    SUM(支払額), \r\n    SUM(倉出), \r\n    SUM(運賃), \r\n    ISNULL(SUM(支払額), 0) + ISNULL(SUM(倉出), 0) + ISNULL(SUM(運賃), 0), \r\n    SUM(メーカー責任額), \r\n    SUM(求債額), \r\n    ISNULL(SUM(メーカー責任額), 0) + ISNULL(SUM(求債額), 0), \r\n    '', \r\n    ''\r\nFROM \r\n    品質問題_Fコスト\r\nGROUP BY \r\n    W番号,\r\n    対象年月",
      "ID": "c4bb025d20ff4fa4bc52401f2098e608"
    },
    {
      "$type": "ServerDesignerCommon.Command.ExecuteSqlCommand, ServerDesignerCommon",
      "ConnStrId": "1B77D134-B2AA-4867-AD46-053B8AD0D7E6",
      "Params": {
        "対象年月": {
          "Item1": {
            "$type": "Forguncy.Model.FormulaReferObject, ServerDesignerCommon",
            "SerializeProperty": "=対象年月"
          },
          "Item2": 16
        }
      },
      "SqlStatement": "UPDATE f\r\nSET f.責任部門 = t.SEKININBUMON\r\nFROM 品質問題_Fコスト集計版 AS f\r\nINNER JOIN tknow t ON f.W番号 = t.W_NBR\r\nwhere f.[対象年月] = @対象年月;",
      "ID": "10ba6eba10c54320905b12892ed926ac"
    }
  ]
